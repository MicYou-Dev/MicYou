{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "micyou",
  "app": {
    "windows": [
      {
        "title": "MicYou",
        "decorations": false,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "minWidth": 800,
        "maxWidth": 800,
        "minHeight": 600,
        "maxHeight": 600
      }
    ]
  },
  "bundle": {
    "resources": [
      "resources/*",
      "resources/alsa/*"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/micyou.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "packaging/micyou.desktop.hbs"
      }
    }
  }
}
